# Copy to .env for local overrides. Nothing here is required to run the tests.

# Where the journey suite and any HTTP-layer suite should point.
# Leave unset and the journey suite starts its own server on a free port.
# TASKFLOW_BASE_URL=http://127.0.0.1:8000

# Opens POST /test/users, the unauthenticated test-data factory.
# NEVER set this in a real deployment - there is a test asserting it stays shut.
ENABLE_TEST_ENDPOINTS=true

# Signing key for JWTs. The default is a known dev value; override anywhere real.
# JWT_SECRET=change-me

DATABASE_URL=sqlite:///./taskflow.db
